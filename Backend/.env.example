# ── NETRA v2 — Environment Configuration ──────────────────
# Copy this file to .env and fill in your credentials

# Bhashini API (register at https://bhashini.gov.in/ulca)
BHASHINI_USER_ID=your-bhashini-user-id
BHASHINI_API_KEY=your-bhashini-api-key

# Server
PORT=3000

# Python path (for bridge)
PYTHON_PATH=python3

# Device override (auto-detected if not set)
# NETRA_DEVICE_TARGET=cuda
# NETRA_VRAM_BUDGET_MB=6144

# Logging
# NETRA_LOG_LEVEL=INFO
